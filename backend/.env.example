# ==============================================================================
# GreenWardrobe Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your local settings:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or API keys to version control.
# ==============================================================================

# Application Metadata
PROJECT_NAME="GreenWardrobe API"
VERSION="1.0.0"
DESCRIPTION="AI-powered garment environmental analysis platform"
API_V1_STR="/api/v1"

# Environment Mode: development | testing | production
ENVIRONMENT="development"
DEBUG=True

# CORS Configuration
# Comma-separated list of allowed frontend origins (Vite default: http://localhost:5173)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Image Upload Constraints
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_IMAGE_FORMATS=["JPEG","PNG","WEBP"]

# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
